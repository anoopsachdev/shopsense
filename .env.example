# Copy to .env and fill in. .env is gitignored; never commit it.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_INTENT_MODEL=your-intent-model-id
GEMINI_RERANK_MODEL=your-rerank-model-id
# USD per 1M tokens, from the Vertex AI pricing page for the models above.
INTENT_PRICE_INPUT_PER_M=0.00
INTENT_PRICE_OUTPUT_PER_M=0.00
RERANK_PRICE_INPUT_PER_M=0.00
RERANK_PRICE_OUTPUT_PER_M=0.00
